# 默认不调用真实模型；复制为本地 .env 后由获授权人员配置。
# 仅支持以下许可路线，不使用系统代理、不跟随重定向，不自动回退或重试。
# 每次最多 60 KB 输入、40 个已有事实字段；输出只作待人工核对的候选和草稿。
# 密钥仅保存在本地；状态/错误不返回密钥或接口错误正文。
ASSISTANT_MODEL_ENABLED=false
ASSISTANT_MODEL_BASE_URL=https://c4ai.ccccltd.cn/api/compatible/v1
ASSISTANT_MODEL_API_KEY=
ASSISTANT_MODEL_NAME=jiaorong-instruct
